{
  "expo": {
    "name": "Vitoria Finance",
    "slug": "vitoria-finance-app",
    "version": "1.0.0",
    "scheme": "vitoriafinance",
    "orientation": "portrait",
    "icon": "./assets/vitoria-finance-face.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/vitoria-finance-face.png",
      "resizeMode": "contain",
      "backgroundColor": "#11141c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitoriafinance.app"
    },
    "android": {
      "package": "com.vitoriafinance.app",
      "adaptiveIcon": {
        "backgroundColor": "#191d27",
        "foregroundImage": "./assets/vitoria-finance-face.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que a VitoriaFinance use o microfone para conversar por áudio.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que a VitoriaFinance acesse uma imagem para ajudar a registrar um gasto.",
          "cameraPermission": "Permita que a VitoriaFinance fotografe um comprovante para ajudar a registrar um gasto."
        }
      ]
    ]
  }
}
